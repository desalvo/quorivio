DATABASE_URL=postgres://quorivio:change-me@db:5432/quorivio
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
NODE_ENV=production

# Optional outgoing email: SMTPS (implicit TLS) only; leave unset to disable.
# Keep passwords in secret storage, never in Git.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Uploaded file antivirus scanning. Production ALWAYS requires a scanner.
# Setting required=false cannot bypass scanning when NODE_ENV=production.
QUORIVIO_AV_REQUIRED=true
# Compose configures this automatically. Helm uses the bundled pod sidecar.
CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# Built-in provider defaults (public endpoints are in source code).
# Google: issuer https://accounts.google.com
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_REDIRECT_URI=
# GitHub: https://github.com/login/oauth/authorize
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=
# Facebook: https://www.facebook.com/v22.0/dialog/oauth
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=
# Additional OIDC providers: OIDC_PROVIDERS_JSON=[...]

# Shared private converter authentication key (>=32 random characters)
QUORIVIO_WORKER_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
