POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=REPLACE_WITH_12_OR_MORE_CHARACTERS
PUBLIC_BASE_URL=http://localhost:8080

# ClamAV is part of the Compose application stack, with persistent signatures.
CLAMAV_IMAGE=clamav/clamav:stable
# Register the following three OAuth/OIDC clients with their providers:
# Google issuer: https://accounts.google.com
# GitHub OAuth authorize: https://github.com/login/oauth/authorize
# Facebook OAuth authorize: https://www.facebook.com/v22.0/dialog/oauth

# Shared private converter authentication key (>=32 random characters)
QUORIVIO_WORKER_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
