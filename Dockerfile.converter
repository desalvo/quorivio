FROM python:3.12-slim-trixie
# Debian 13 security advisory DSA-6607-1 (CVE-2026-109518):
# upgrade APT and its library before installing other packages.
# The vulnerable APT client must not retry downloads during its own upgrade.
# Fail closed if the fixed packages are not yet available from trixie-security.
# Security preflight: update zlib1g (CVE-2026-76844 / CVE-2026-85091)
RUN set -eux; \
    apt-get -o Acquire::Retries=0 update; \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=0 install -y --no-install-recommends --only-upgrade apt libapt-pkg7.0; \
    for package in apt libapt-pkg7.0; do \
      version="$(dpkg-query -W -f='${Version}' "$package")"; \
      if ! dpkg --compare-versions "$version" ge 3.0.4; then \
        echo "Unsafe Debian APT package $package at $version (requires >= 3.0.4)" >&2; \
        exit 1; \
      fi; \
    done; \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=0 install -y --no-install-recommends --only-upgrade zlib1g; \
    zlib_version="$(dpkg-query -W -f='${Version}' zlib1g)"; \
    dpkg --compare-versions "$zlib_version" ge '1:1.3.dfsg+really1.3.1-1+deb13u1' || { echo "Unsafe Debian zlib1g package: $zlib_version" >&2; exit 1; }; \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=0 install -y --no-install-recommends poppler-utils libreoffice-impress chromium fonts-dejavu-core fonts-lato fonts-liberation; \
    rm -rf /var/lib/apt/lists/*; \
    useradd -u 1000 -m converter; \
    mkdir /conversions; \
    chown converter:converter /conversions
WORKDIR /app/tools
RUN pip install --no-cache-dir python-pptx==1.0.2 'Pillow>=11,<14' qrcode==8.2 'playwright>=1.55,<2'
COPY tools/import_presentation.py tools/conversion_worker.py tools/pptx_portable.py tools/pdf_portable.py tools/visual_export.py ./
USER converter
ENV PYTHONDONTWRITEBYTECODE=1 QUORIVIO_CONVERSION_DIR=/conversions
EXPOSE 8099
CMD ["python3","conversion_worker.py"]
