FROM python:3.12-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends poppler-utils libreoffice-impress fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m converter && mkdir /conversions && chown converter:converter /conversions
WORKDIR /app/tools
COPY tools/import_presentation.py tools/conversion_worker.py ./
USER converter
ENV PYTHONDONTWRITEBYTECODE=1 QUORIVIO_CONVERSION_DIR=/conversions
EXPOSE 8099
CMD ["python3","conversion_worker.py"]
